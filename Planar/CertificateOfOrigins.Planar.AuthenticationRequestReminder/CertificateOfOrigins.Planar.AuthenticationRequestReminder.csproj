<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CertificateOfOrigins.Planar.AuthenticationRequestReminder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\API\CertificateOfOrigins.BL\CertificateOfOrigins.BL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings Planar.Job 1.8.1 (BaseJob + PlanarJob) and the fake HttpContext the BL relies on. Do NOT drop to
         the 1.5.x line: it targets net7.0 and exposes a different API. -->
    <PackageReference Include="CustomsCloud.InfrastructureCore.PlanarJob" Version="1.10.58" />

    <!-- API/Directory.Build.props scopes to API/**, so a Planar project has to carry the analyzers and the
         security pins itself — otherwise the job would build under looser rules than the rest of the repo. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.31.0.145097">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;NU1803;NU1603;NU1608</NoWarn>
  </PropertyGroup>

</Project>
