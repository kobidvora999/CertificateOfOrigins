      "script": {
        "type": "text/javascript",
        "exec": [
          "// Platform mock-proxy convention (C4): REAL proxies are the default; route the outbound proxy",
          "// calls to the in-service mock during local/test runs via the x-mock-proxy header. The framework",
          "// parses a single comma-separated header, so set ONE header (upsert per-interface would overwrite,",
          "// leaving only the last interface mocked and the others hitting the real service).",
          "pm.request.headers.upsert({ key: 'x-mock-proxy', value: ['ICustomerProxy', 'IVendorProxy', 'IExportDealFileProxy', 'IUserProxy', 'IDataDictionaryFieldProxy', 'ICurrencyTypeProxy', 'IDocumentsProxy', 'ICollateralProxy', 'ITasksProxy', 'IMessageManagementProxy'].join(',') });"
